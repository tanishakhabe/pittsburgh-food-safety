# Copy this file to .env and fill in the real values (ask the team).
# .env is git-ignored; never commit real credentials.

# PostgreSQL (AWS RDS): all raw / staging / serving schemas live on this one instance
PGHOST=group7-food-safety.c3gemkgwuf59.us-east-2.rds.amazonaws.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=your_username
PGPASSWORD=your_password
PGSSLMODE=require

# MongoDB Atlas: semi-structured neighborhood GeoJSON
MONGO_URI=mongodb+srv://your_username:your_password@group7.9ag8xuo.mongodb.net/
MONGO_DB=group7
